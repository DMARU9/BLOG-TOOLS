# OpenCode API (OpenAI-compatible) - OpenDeepResearch 設定を流用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# YouTube Trend Researcher 設定
YTR_MODEL=openai:mimo-v2.5
# 字幕取得の優先言語（既定: ja）
YTR_TRANSCRIPT_LANG=ja
# 解析対象件数の既定値（指示で上書き可）
YTR_MAX_RESULTS=5
# 中間成果物のキャッシュ先ディレクトリ
YTR_CACHE_DIR=cache
# LLM 呼び出しの最大リトライ回数
YTR_MAX_RETRIES=3
