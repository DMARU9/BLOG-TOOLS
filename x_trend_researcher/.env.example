# OpenCode API (OpenAI-compatible) - OpenDeepResearch 設定を流用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# X Trend Researcher 設定
XTR_MODEL=openai:mimo-v2.5
# 解析対象件数の既定値（指示で上書き可）
XTR_MAX_RESULTS=5
# 中間成果物のキャッシュ先ディレクトリ
XTR_CACHE_DIR=cache
# LLM 呼び出しの最大リトライ回数
XTR_MAX_RETRIES=3
# twscrape が使用するアカウント DB（クッキーを保存）
XTR_ACCOUNTS_DB=accounts.db
